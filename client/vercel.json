{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    {
      "source": "/products/:id",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(Googlebot|Google-InspectionTool|Storebot-Google|bingbot|Bingbot|YandexBot|DuckDuckBot|Applebot|facebookexternalhit|Facebot|meta-externalagent|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Slackbot|Discordbot|Pinterest|SkypeUriPreview|redditbot|Embedly|Viber).*" }],
      "destination": "/api/seo?type=product&id=:id"
    },
    {
      "source": "/products",
      "has": [
        { "type": "header", "key": "user-agent", "value": ".*(Googlebot|Google-InspectionTool|Storebot-Google|bingbot|Bingbot|YandexBot|DuckDuckBot|Applebot|facebookexternalhit|Facebot|meta-externalagent|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Slackbot|Discordbot|Pinterest|SkypeUriPreview|redditbot|Embedly|Viber).*" },
        { "type": "query", "key": "cat", "value": "(?<cat>\\d+)" }
      ],
      "destination": "/api/seo?type=category&id=:cat"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
