# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Supabase ─────────────────────────────────────────────
SUPABASE_URL=https://xxxxxx.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─── JWT ──────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_BYTE_HEX_SECRET

JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Cookie ───────────────────────────────────────────────
COOKIE_SECRET=REPLACE_WITH_32_BYTE_HEX_SECRET

# ─── CORS ─────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Rate Limiting ────────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
ACCOUNT_LOCKOUT_MINUTES=30

# ─── First-time Admin Seed (run: npm run seed) ────────────
# Remove these after seeding — they are only needed once.
SEED_ADMIN_EMAIL=your@email.com
SEED_ADMIN_PASSWORD=ChangeMe@123
SEED_ADMIN_NAME=Your Name

# ─── AI assistant ─────────────────────────────────────────
# Free providers (no credit card). Set one or both; the assistant stays off
# until at least one key is set. Tried in order; if one hits its free limit
# the next one answers automatically.
CEREBRAS_API_KEY=                  # https://cloud.cerebras.ai  (≈1M tokens/day free)
GROQ_API_KEY=                      # https://console.groq.com   (≈200k tokens/day free)
# AI_PROVIDERS=cerebras,groq       # optional: order to try (also: ollama, claude)
# CEREBRAS_MODEL=gpt-oss-120b
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: your own Ollama (e.g. through a secured tunnel)
# OLLAMA_URL=https://your-tunnel.example.com
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_API_KEY=

# Optional, PAID: Claude. Only used if ANTHROPIC_API_KEY is set.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-4-5
# AI_MONTHLY_BUDGET_USD=5          # hard stop per month (Claude only)

AI_DAILY_MESSAGES_PER_ADMIN=60
